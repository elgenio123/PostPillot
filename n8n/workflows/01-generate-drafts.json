    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "options": {
          "timeout": 120000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.OPENROUTER_API_KEY }}"
            },
            {
              "name": "X-Title",
              "value": "PostPilot"
            },
            {
              "name": "HTTP-Referer",
              "value": "https://github.com/postpilot-demo"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('One platform at a time').item.json.model, messages: $('One platform at a time').item.json.messages, response_format: { type: 'json_object' }, usage: { include: true } }) }}"
      },
      "id": "34036a23-2d04-cdf7-3f43-8c6e1a4e3211",
      "name": "Draft post with AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        660
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Reads the AI answer. ok = false means \"ask again\".\nconst job = $(\"One platform at a time\").item.json;\nconst content = $json.choices?.[0]?.message?.content ?? \"\";\nconst parsed = readJson(content);\nconst ok = !!(parsed && typeof parsed.text === \"string\" && parsed.text.trim().length > 20);\nreturn {\n  json: {\n    ...job,\n    ok,\n    text: ok ? parsed.text.trim() : \"\",\n    hashtags: ok && Array.isArray(parsed.hashtags) ? parsed.hashtags : [],\n    raw: String(content),\n    cost: $json.usage?.cost ?? 0,\n    error: $json.error?.message ?? null,\n  },\n};\n\nfunction readJson(content) {\n  if (!content) return null;\n  const s = String(content).trim().replace(/^```(?:json)?\\s*/i, \"\").replace(/```\\s*$/, \"\");\n  try { return JSON.parse(s); } catch (e) {}\n  const m = s.match(/\\{[\\s\\S]*\\}/);\n  if (m) { try { return JSON.parse(m[0]); } catch (e) {} }\n  return null;\n}"
      },
      "id": "08cce709-6112-7df0-10dc-4c7645003359",
      "name": "Check the AI answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        660
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "e0f063d8-b771-de5b-0994-922452144eee",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "12372bd6-405f-d197-6dac-a808cd84a715",
      "name": "Answer usable?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2200,
        660
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "options": {
          "timeout": 120000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.OPENROUTER_API_KEY }}"
            },
            {
              "name": "X-Title",
              "value": "PostPilot"
            },
            {
              "name": "HTTP-Referer",
              "value": "https://github.com/postpilot-demo"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $json.model, messages: $json.messages.concat([{ role: 'assistant', content: $json.raw || '(empty)' }, { role: 'user', content: 'That answer was not valid. Reply again with ONLY the JSON object with the keys text and hashtags. No other words.' }]), response_format: { type: 'json_object' }, usage: { include: true } }) }}"
      },
      "id": "80d172e5-3a09-0fa9-f9d3-7826e06b20fa",
      "name": "Ask again, stricter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2420,
        860
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const first = $(\"Answer usable?\").item.json;\nconst content = $json.choices?.[0]?.message?.content ?? \"\";\nconst parsed = readJson(content);\nlet ok = !!(parsed && typeof parsed.text === \"string\" && parsed.text.trim().length > 20);\nlet text = ok ? parsed.text.trim() : \"\";\n// Last resort: use the plain answer as the post if it looks like one\nif (!ok && String(content).trim().length > 40 && !String(content).includes(\"{\")) {\n  ok = true;\n  text = String(content).trim();\n}\nreturn {\n  json: {\n    ...first,\n    ok,\n    text,\n    hashtags: ok && Array.isArray(parsed?.hashtags) ? parsed.hashtags : [],\n    cost: first.cost + ($json.usage?.cost ?? 0),\n    error: ok ? null : ($json.error?.message ?? \"The AI did not return a usable post\"),\n  },\n};\n\nfunction readJson(content) {\n  if (!content) return null;\n  const s = String(content).trim().replace(/^```(?:json)?\\s*/i, \"\").replace(/```\\s*$/, \"\");\n  try { return JSON.parse(s); } catch (e) {}\n  const m = s.match(/\\{[\\s\\S]*\\}/);\n  if (m) { try { return JSON.parse(m[0]); } catch (e) {} }\n  return null;\n}"
      },
      "id": "3a36d59c-73d6-7d59-9a04-472461540f10",
      "name": "Check second answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        860
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "9b850de7-c2e7-97c0-0e30-d2c2bdb403a2",
              "leftValue": "={{ $json.ok && $json.platform === $json.trapPlatform }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "8a148c4c-3fba-e9f0-2e90-702632b50d43",
      "name": "Is this the trap draft?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2860,
        660
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "options": {
          "timeout": 120000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.OPENROUTER_API_KEY }}"
            },
            {
              "name": "X-Title",
              "value": "PostPilot"
            },
            {
              "name": "HTTP-Referer",
              "value": "https://github.com/postpilot-demo"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $json.model, messages: [{ role: 'system', content: $json.trapPrompt }, { role: 'user', content: 'Event brief:\\n' + $json.brief + '\\n\\nPost:\\n' + $json.text }], response_format: { type: 'json_object' }, usage: { include: true } }) }}"
      },
      "id": "4c0a450d-db32-8259-9043-9d70561d03cf",
      "name": "Plant the demo mistake",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3080,
        860
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Keeps the original draft if the trap could not be planted\nconst draft = $(\"Is this the trap draft?\").item.json;\nconst p = readJson($json.choices?.[0]?.message?.content);\nconst cost = draft.cost + ($json.usage?.cost ?? 0);\nif (p && typeof p.text === \"string\" && p.text.trim() && p.planted_quote) {\n  return { json: { ...draft, text: p.text.trim(), cost, trap: { quote: p.planted_quote, explanation: p.explanation ?? \"\" } } };\n}\nreturn { json: { ...draft, cost } };\n\nfunction readJson(content) {\n  if (!content) return null;\n  const s = String(content).trim().replace(/^```(?:json)?\\s*/i, \"\").replace(/```\\s*$/, \"\");\n  try { return JSON.parse(s); } catch (e) {}\n  const m = s.match(/\\{[\\s\\S]*\\}/);\n  if (m) { try { return JSON.parse(m[0]); } catch (e) {} }\n  return null;\n}"
      },
      "id": "82c71565-5b3b-4d9a-b0ab-3b4f93786fbf",
      "name": "Read the planted mistake",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3300,
        860
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const words = $json.text ? $json.text.split(/\\s+/).length : 0;\nconst message = $json.ok\n  ? $json.label + \" draft ready (\" + words + \" words)\"\n  : \"Could not write the \" + $json.label + \" post: \" + ($json.error ?? \"unknown error\");\nreturn { json: { ...$json, message } };"
      },
      "id": "1c7ce64a-8ae1-6b08-0a64-14bdc49fe22c",
      "name": "Draft is final",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3520,
        660
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_INTERNAL_URL }}/api/internal/runs/{{ $json.runId }}/events",
        "options": {
          "timeout": 30000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-postpilot-secret",
              "value": "={{ $env.POSTPILOT_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ step: 'draft_' + $json.platform, status: $json.ok ? 'done' : 'failed', message: $json.message, data: { text: $json.text, hashtags: $json.hashtags, trap: $json.trap ?? null }, cost: $json.cost, executionId: $execution.id, workflow: $workflow.id }) }}"
      },
      "id": "fcba6cd2-e61a-323b-5d72-be9af38a59e6",
      "name": "Tell app: draft ready",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3740,
        660
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: $(\"Draft is final\").item.json };"
      },
      "id": "d1b98468-54df-29b5-964b-ade6d7c3a162",
      "name": "Back to the loop",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3960,
        660
      ]
    },
    {
      "parameters": {
        "content": "### 3. Paint one image\nOne image for the whole brief (the app crops it for each platform).\n1. The AI describes the picture.\n2. **OpenRouter** image model paints it.\n3. If that fails: free **Pollinations.ai**.\n4. If that fails too: the app draws a **branded template**. This step never fails.",
        "width": 2240,
        "height": 520,
        "color": 6
      },
      "id": "59619fd4-a6f4-fd7a-7d7f-a8d7ac0d7a27",
      "name": "Note 4",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1260,
        1060
      ]
    },
    {
      "parameters": {
        "jsCode": "// The loop is finished. Continue only if at least one post was written.\nconst drafts = $input.all().map((i) => i.json).filter((d) => d.ok);\nif (!drafts.length) return [];\nconst first = drafts[0];\nreturn [{\n  json: {\n    runId: first.runId,\n    model: first.model,\n    brief: first.brief,\n    organisation: first.organisation,\n    drafts: drafts.map((d) => ({ platform: d.platform, text: d.text, trap: d.trap ?? null })),\n  },\n}];"
      },
      "id": "a75a1bf9-c55d-a761-0607-2a0017f4e60b",
      "name": "All drafts written",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        1240
      ]
    },
    {
      "parameters": {
