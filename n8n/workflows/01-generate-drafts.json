              "name": "x-postpilot-secret",
              "value": "={{ $env.POSTPILOT_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ step: 'draft_' + $('One platform at a time').item.json.platform, status: 'running', message: 'Writing the ' + $('One platform at a time').item.json.label + ' post with ' + $('One platform at a time').item.json.model, executionId: $execution.id, workflow: $workflow.id }) }}"
      },
      "id": "2e305124-bee3-e6f6-1ed9-5f5697f7682e",
      "name": "Tell app: drafting",
