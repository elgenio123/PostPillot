    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ctx = $(\"All drafts written\").item.json;\nconst prompts = $(\"Load prompts\").first().json.prompts;\nconst drafts = ctx.drafts.map((d) => \"### \" + d.platform + \"\\n\" + d.text).join(\"\\n\\n\");\nreturn {\n  json: {\n    runId: ctx.runId,\n    model: ctx.model,\n    drafts: ctx.drafts,\n    messages: [\n      { role: \"system\", content: prompts[\"safety-check\"] + \"\\n\\n\" + prompts[\"safety-rules\"] },\n      { role: \"user\", content: \"Event brief:\\n\" + ctx.brief + \"\\n\\nDrafts:\\n\" + drafts },\n    ],\n  },\n};"
      },
      "id": "7a3c5dda-25e1-1aac-b8ed-eef40d35ab8c",
      "name": "Prepare safety check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3820,
        1240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "options": {
          "timeout": 120000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.OPENROUTER_API_KEY }}"
            },
            {
              "name": "X-Title",
              "value": "PostPilot"
            },
            {
              "name": "HTTP-Referer",
              "value": "https://github.com/postpilot-demo"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $json.model, messages: $json.messages, response_format: { type: 'json_object' }, usage: { include: true } }) }}"
      },
      "id": "340f5ab5-0cda-793e-76d8-e3a355c929c9",
      "name": "Safety check with AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        4040,
        1240
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ctx = $(\"Prepare safety check\").item.json;\nconst p = readJson($json.choices?.[0]?.message?.content);\nconst list = Array.isArray(p?.drafts) ? p.drafts : [];\nconst drafts = ctx.drafts.map((d) => {\n  const found = list.find((x) => String(x.platform).toLowerCase() === d.platform);\n  let flags = Array.isArray(found?.flags) ? found.flags.filter((f) => f && f.quote) : [];\n  // Demo trap: hide warnings about the planted mistake so the human has to spot it\n  if (d.trap?.quote) flags = flags.filter((f) => !overlaps(f.quote, d.trap.quote));\n  return { platform: d.platform, flags };\n});\nconst total = drafts.reduce((s, d) => s + d.flags.length, 0);\nreturn { json: { runId: ctx.runId, ok: !!p, drafts, total, cost: $json.usage?.cost ?? 0 } };\n\nfunction readJson(content) {\n  if (!content) return null;\n  const s = String(content).trim().replace(/^```(?:json)?\\s*/i, \"\").replace(/```\\s*$/, \"\");\n  try { return JSON.parse(s); } catch (e) {}\n  const m = s.match(/\\{[\\s\\S]*\\}/);\n  if (m) { try { return JSON.parse(m[0]); } catch (e) {} }\n  return null;\n}\n\nfunction overlaps(a, b) {\n  const words = (s) => String(s).toLowerCase().match(/[\\p{L}\\p{N}]+/gu) ?? [];\n  const wa = words(a), wb = new Set(words(b));\n  if (!wa.length || !wb.size) return false;\n  const shared = wa.filter((x) => wb.has(x)).length;\n  return shared / Math.min(wa.length, wb.size) >= 0.5;\n}"
      },
      "id": "1b1cfb16-8d88-e163-3290-3b89e39f781c",
      "name": "Read flags & hide the demo trap",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
