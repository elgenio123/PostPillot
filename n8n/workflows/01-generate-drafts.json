        "jsonBody": "={{ JSON.stringify({ step: 'image', status: 'running', message: 'Imagining a picture for the event', executionId: $execution.id, workflow: $workflow.id }) }}"
      },
      "id": "6cf515db-6160-f645-6d50-0af05d277f1e",
      "name": "Tell app: creating image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
