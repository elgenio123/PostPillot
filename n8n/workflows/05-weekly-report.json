{
  "id": "ppWeeklyReport01",
  "name": "PostPilot – Weekly report",
  "nodes": [
    {
      "parameters": {
        "content": "## PostPilot – Weekly report\nTwo ways to start: **every Monday at 08:00**, or the **Generate report** button in the app.\nWe collect last week's posts and their numbers (Facebook Graph API, or fake numbers in Mock mode; LinkedIn has no free statistics), then the AI writes a short plain-English report.",
        "width": 720,
        "height": 280,
        "color": 4
      },
      "id": "dcc20583-fecf-d3d0-d32e-06a6d5bb74ca",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -120
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "3c52c10e-02a3-572a-6acd-f80da7f9a664",
      "name": "Every Monday at 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        220
      ]
    },
