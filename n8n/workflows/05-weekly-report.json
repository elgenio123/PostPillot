        "path": "postpilot-report",
        "options": {}
      },
      "id": "c21df3fd-fe17-8883-dc36-d52959a320f7",
      "name": "Report button pressed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        440
      ],
      "webhookId": "1a2de6a7-4e4b-e3fb-aec1-37d4577a6874"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "ebd88006-9e9a-07e7-fe92-af0f7098f2f6",
              "leftValue": "={{ $('Report button pressed').item.json.headers['x-postpilot-secret'] === $env.POSTPILOT_SECRET }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "35daa34e-0ffe-e343-d5e6-ef8ffd8b33c8",
      "name": "Is this our app?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        440
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.APP_INTERNAL_URL }}/api/internal/report-data",
        "options": {
          "timeout": 30000
        },
        "sendHeaders": true,
        "headerParameters": {
