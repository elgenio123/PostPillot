    {
      "parameters": {
        "content": "### LinkedIn\n1. Wait until the chosen time (if scheduled).\n2. Ask LinkedIn for an upload slot, upload the image.\n3. Create the post with the image.\nLinkedIn text uses a special format, so we escape symbols and turn #tags into LinkedIn hashtags.",
        "width": 1820,
        "height": 380,
        "color": 6
      },
      "id": "fc284991-caad-1daf-6e4b-e25e5a498b46",
      "name": "Note 4",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        820,
        780
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a235511b-ad71-6625-dca3-09f3c1f45cf5",
              "leftValue": "={{ !!$('Post to publish').item.json.body.scheduledAt }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "e0f6955c-cb86-ea10-bb32-4be2368bee0d",
      "name": "Scheduled for later? (LinkedIn)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        960
      ]
    },
    {
      "parameters": {
        "resume": "specificTime",
        "dateTime": "={{ $('Post to publish').item.json.body.scheduledAt }}"
      },
      "id": "3778c9b1-67fc-4824-4e83-e9fa1b393877",
      "name": "Wait until the scheduled time",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1100,
        880
      ],
      "webhookId": "8b2d3f44-6c9e-4a1f-b2d3-3c4e5f6a7b02"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const req = $(\"Post to publish\").item.json.body;\n// LinkedIn \"little text\" format: reserved symbols must be escaped, hashtags use a template\nconst tags = [];\nlet t = req.text.replace(/#([\\p{L}\\p{N}_]+)/gu, (m, tag) => { tags.push(tag); return \"\\u0000\" + (tags.length - 1) + \"\\u0000\"; });\nt = t.replace(/[\\\\|{}@\\[\\]()<>#*_~]/g, (c) => \"\\\\\" + c);\nt = t.replace(/\\u0000(\\d+)\\u0000/g, (m, i) => \"{hashtag|\\\\#|\" + tags[Number(i)] + \"}\");\nreturn { json: { postId: req.postId, commentary: t, imagePath: req.imagePath } };"
      },
      "id": "c435b8a3-f3b5-9650-531c-dad035f55e83",
      "name": "Prepare LinkedIn text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        960
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.linkedin.com/rest/images?action=initializeUpload",
        "options": {
          "timeout": 30000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.LINKEDIN_TOKEN }}"
            },
            {
              "name": "LinkedIn-Version",
              "value": "={{ $env.LINKEDIN_API_VERSION }}"
            },
            {
              "name": "X-Restli-Protocol-Version",
              "value": "2.0.0"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ initializeUploadRequest: { owner: $env.LINKEDIN_AUTHOR_URN } }) }}"
      },
      "id": "0b41bb9e-d010-872c-46e6-f100dd9d3300",
      "name": "Get a LinkedIn upload slot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        960
      ],
      "onError": "continueRegularOutput"
    },
