      },
      "id": "6eb8f56c-e036-2034-cbe2-9abec7c50851",
      "name": "Upload image to LinkedIn",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        960
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.linkedin.com/rest/posts",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.LINKEDIN_TOKEN }}"
            },
            {
              "name": "LinkedIn-Version",
              "value": "={{ $env.LINKEDIN_API_VERSION }}"
            },
            {
              "name": "X-Restli-Protocol-Version",
              "value": "2.0.0"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ author: $env.LINKEDIN_AUTHOR_URN, commentary: $('Prepare LinkedIn text').item.json.commentary, visibility: 'PUBLIC', distribution: { feedDistribution: 'MAIN_FEED', targetEntities: [], thirdPartyDistributionChannels: [] }, content: { media: { id: $('Get a LinkedIn upload slot').item.json.value?.image, altText: 'Event illustration' } }, lifecycleState: 'PUBLISHED', isReshareDisabledByAuthor: false }) }}"
      },
      "id": "5b07699d-2e58-f9bd-cdfc-bf37c22f4642",
      "name": "Create LinkedIn post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        960
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const postId = $(\"Prepare LinkedIn text\").item.json.postId;\nconst slot = $(\"Get a LinkedIn upload slot\").item.json;\nconst err = slot.error || $(\"Upload image to LinkedIn\").item.json.error || $json.error;\nif (err) return { json: { postId, status: \"failed\", error: \"LinkedIn: \" + (err.description || err.message || JSON.stringify(err)) } };\nconst urn = $json.headers?.[\"x-restli-id\"] || $json.headers?.[\"x-linkedin-id\"];\nreturn { json: { postId, status: \"published\", externalId: urn, url: urn ? \"https://www.linkedin.com/feed/update/\" + urn + \"/\" : null } };"
      },
      "id": "ffc7ed6f-d0ee-e9e7-32fc-696085ed46eb",
      "name": "Read LinkedIn answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        960
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_INTERNAL_URL }}/api/internal/posts/{{ $json.postId }}",
        "options": {
          "timeout": 30000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-postpilot-secret",
              "value": "={{ $env.POSTPILOT_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: $json.status, externalId: $json.externalId, url: $json.url, error: $json.error }) }}"
      },
      "id": "388705b1-7356-7e9e-ef59-c001a1aa1678",
