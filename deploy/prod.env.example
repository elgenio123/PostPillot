# Template for the PROD_ENV GitHub secret (the server's .env). Copy, fill in, paste the whole text into the secret.
# The deploy job adds WEB_IMAGE / N8N_IMAGE itself, and N8N_WEBHOOK_URL when you leave it out.

# Your public hostname. On AWS use <elastic-ip-with-dashes>.sslip.io (e.g. 13-38-120-7.sslip.io).
# (Let's Encrypt refuses the ec2-....amazonaws.com names, so they cannot get HTTPS.)
# Empty = plain HTTP on the server IP (passwords travel unencrypted: avoid).
APP_DOMAIN=
# true when APP_DOMAIN is set
N8N_SECURE_COOKIE=true

# Long random values: openssl rand -hex 24 (letters and digits only)
POSTPILOT_SECRET=
POSTGRES_USER=postpilot
POSTGRES_PASSWORD=
POSTGRES_DB=postpilot

# First login of the web app (created once, change it after the first sign-in)
ADMIN_EMAIL=admin@your-school.cm
ADMIN_PASSWORD=
ADMIN_NAME=Demonstrator

# n8n editor login (created once on the first start)
N8N_OWNER_EMAIL=admin@your-school.cm
N8N_OWNER_PASSWORD=

OPENROUTER_API_KEY=
IMAGE_MODEL=google/gemini-nano-banana-2.1
POLLINATIONS_URL=https://image.pollinations.ai/prompt/{prompt}?width=1200&height=630&nologo=true
# Model that films video posts (when "Video" is chosen on the brief page). Must support 5-10 s on OpenRouter:
# https://openrouter.ai/api/v1/videos/models lists each model's supported_durations and price per second.
# x-ai/grok-imagine-video-1.5-lite is the cheapest: about $0.02/s at 480p, so a 5 s video costs about $0.10.
VIDEO_MODEL=x-ai/grok-imagine-video-1.5-lite
# 480p is the lowest OpenRouter offers and keeps videos cheap (720p costs about 1.5x, 1080p about 7x).
VIDEO_RESOLUTION=480p

TIMEZONE=Africa/Douala
FCFA_PER_USD=600

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_GRAPH_VERSION=v23.0

LINKEDIN_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=202608
LINKEDIN_VISIBILITY=CONNECTIONS
