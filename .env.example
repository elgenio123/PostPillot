# Copy this file to .env and fill in the values. Never commit .env.

# Shared secret between the app and n8n. Any long random string (e.g. `openssl rand -hex 24`).
POSTPILOT_SECRET=change-me-to-a-long-random-string

# Login portal. This account is created in the database on the first start (only when no user exists yet).
# Change the password after the first sign-in (account menu, top right). Changing these values later has no effect.
ADMIN_EMAIL=admin@postpilot.local
ADMIN_PASSWORD=PostPilot2026!
ADMIN_NAME=Demonstrator
# Force the Secure flag on the session cookie. Not needed behind HTTPS (detected automatically).
COOKIE_SECURE=false

# PostgreSQL, shared by the app (database "postpilot") and n8n (database "n8n").
# Use letters and digits only for the password (it is placed in a connection URL), e.g. `openssl rand -hex 24`.
POSTGRES_USER=postpilot
POSTGRES_PASSWORD=change-me-to-a-long-random-hex-string
POSTGRES_DB=postpilot

# OpenRouter API key (https://openrouter.ai/settings/keys). Required: all AI text and images use it.
OPENROUTER_API_KEY=
# Model that paints the event image. Must support image output on OpenRouter.
IMAGE_MODEL=google/gemini-nano-banana-2.1
# Free image fallback used when the OpenRouter image fails. {prompt} is replaced by the image description.
POLLINATIONS_URL=https://image.pollinations.ai/prompt/{prompt}?width=1200&height=630&nologo=true
# Model that films video posts (when "Video" is chosen on the brief page). Must support 5-10 s on OpenRouter:
# https://openrouter.ai/api/v1/videos/models lists each model's supported_durations and price per second.
# x-ai/grok-imagine-video-1.5-lite is the cheapest: about $0.02/s at 480p, so a 5 s video costs about $0.10.
VIDEO_MODEL=x-ai/grok-imagine-video-1.5-lite
# 480p is the lowest OpenRouter offers and keeps videos cheap (720p costs about 1.5x, 1080p about 7x).
VIDEO_RESOLUTION=480p

# n8n login, created automatically on first start. Password: 8+ chars with a number and a capital letter.
N8N_OWNER_EMAIL=demo@postpilot.local
N8N_OWNER_PASSWORD=PostPilot2026
# n8n version tag. Tested with 2.42.6. Pin it before the event (e.g. N8N_VERSION=2.42.6) so nothing changes on the day.
N8N_VERSION=latest
# Address of n8n as seen from the browser and from your phone (Telegram buttons).
# Default works on the laptop only. For the phone: http://<laptop-LAN-IP>:5678/ or run scripts/tunnel.sh.
N8N_WEBHOOK_URL=http://localhost:5678/

# Timezone for schedules and the weekly report.
TIMEZONE=Africa/Douala
# Exchange rate used by the cost counter.
FCFA_PER_USD=600

# Telegram approval (optional). Bot token from @BotFather, chat ID from @userinfobot. See docs/accounts-setup.md.
# Several people: separate the IDs with commas, e.g. 123456789,987654321. Each person must press Start in the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Facebook Page publishing (optional, only for Real mode). Long-lived Page access token.
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_GRAPH_VERSION=v23.0

# LinkedIn publishing (optional, only for Real mode). Member access token with w_member_social scope.
LINKEDIN_TOKEN=
# Your member URN, e.g. urn:li:person:AbC123 (the Settings page "Test" button shows it).
LINKEDIN_AUTHOR_URN=
# LinkedIn REST API version, format YYYYMM. Must be less than one year old.
LINKEDIN_API_VERSION=202608
# Who sees LinkedIn posts: PUBLIC (anyone) or CONNECTIONS (only your 1st-degree connections). Use CONNECTIONS while testing.
LINKEDIN_VISIBILITY=CONNECTIONS

# Server only (deploy/docker-compose.prod.yml). Your public hostname, e.g. 13-38-120-7.sslip.io for an AWS Elastic IP.
# With it, Caddy gets a free HTTPS certificate; leave it empty to serve plain HTTP on the server IP.
APP_DOMAIN=
# Set to true on the server when APP_DOMAIN is set (n8n login cookie over HTTPS only).
N8N_SECURE_COOKIE=false
